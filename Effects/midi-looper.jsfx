desc:MIDI Looper (8 Slots)
// Slot control + feedback use gmem instead of MIDI protocol.
// options:gmem namespace: HSP_RPLT
//
// gmem index 0: Heartbeat. When this value changes, the orchestrator has requested a reindex with a full-update of all instances.
// Instance ID is selected by slider1 (Track Number).
//
// Each instance then gets a 20-index private state memory block:
//   base = instance_id * 20
//   base+0..7         Output: The state of each recording slot: 0 = empty, 1 = not-empty, 2 = playing 3 = recording
//   base+8..15        Input: The orchestrator writes slot commands here. Any non-zero value means "pending command".
//                     Command mapping after rounding/clamping: 1 = trigger (play if not-empty, record if empty), 2 = overdub, 3 = clear
//                     The FX executes the command and always resets this cell back to 0 (acknowledged/done).
//   base+16           Input: The orchestrator will send instance-wide commands here:
//                     Any non-zero value = full-update (this instance updates all slot states), then resets to 0 as ACK
//   base+17           Output: Instance sets this to 1 when it exists. Orchestrator will initialize this to 0 in order to find out who's 
//                     there and who's not.
//
// When a full-update is requested, this instance immediately writes all slot states.

options:gmem=HSP_RPLT

slider1:1<1,16,1>Track Number

@init

// ─── Initialise ────────────────────────────────────────────────────────────────
// @init runs on plugin load AND on every transport start/stop. Normally REAPER
// zeroes ALL memory and variables before each @init call. The presence of a
// non-empty @serialize section (see bottom of file) suppresses that behaviour,
// so memory and variables survive transport events without any sentinel tricks.

// Re-declare constants on every @init (they always get the same values anyway):
STATE_EMPTY           = 0;
STATE_REC_ARMED       = 1;
STATE_RECORDING       = 2;
STATE_STOP_REC_ARMED  = 3;
STATE_PLAYING         = 4;
STATE_PLAY_ARMED      = 5;
STATE_STOP_PLAY_ARMED = 6;
STATE_STOPPED         = 7;
STATE_OD_ARMED        = 8;
STATE_OVERDUBBING     = 9;
STATE_STOP_OD_ARMED   = 10;

NUM_SLOTS             = 8;
MAX_EVENTS            = 4096;
EVENT_SIZE            = 4;

MEM_STATE       = 0;
MEM_EVT_COUNT   = 16;
MEM_LOOP_LEN    = 32;
MEM_REC_START   = 48;
MEM_PLAY_START  = 64;
MEM_TARGET      = 80;
MEM_PLAY_NOTES  = 128;
MEM_REC_NOTES   = 1200;
MEM_EVENTS      = 2500;

GMEM_TOTAL_CELLS       = 1048576;
GMEM_GLOBAL_HEARTBEAT  = 0;
GMEM_GLOBAL_IDPROVIDER = 1;
GMEM_INST_STRIDE       = 20;
GMEM_INSTANCE_BASE_MIN = 20;
GMEM_MAX_INSTANCES     = floor((GMEM_TOTAL_CELLS - GMEM_INSTANCE_BASE_MIN) / GMEM_INST_STRIDE);
GMEM_OFF_STATE         = 0;
GMEM_OFF_RAWSTATE      = 0;
GMEM_OFF_CMD           = 8;
GMEM_OFF_INSTANCE_CMD  = 16;
GMEM_OFF_INSTANCE_EXISTS = 17;

INSTANCE_ID          = max(INSTANCE_ID, 0);
INSTANCE_BASE        = max(INSTANCE_BASE, 0);
LAST_GMEM_HEARTBEAT  = max(LAST_GMEM_HEARTBEAT, -1);

// Clear slot data only on first load (memory is 0 at load time).
// On subsequent @init calls (transport events) memory is preserved because
// @serialize is defined below — so this block naturally does nothing since
// the slot states will already be non-zero for any slot in use.
i = 0;
loop(NUM_SLOTS,
  MEM_STATE[i]      == 0 ? MEM_STATE[i]      = STATE_EMPTY;
  i += 1;
);

// Request one-shot feedback refresh after each @init (load + transport events)
FEEDBACK_REFRESH_PENDING = 1;

// ─── Helper functions ──────────────────────────────────────────────────────────

// Next quantized boundary based on slider2 (quarter-note units)
function next_quant_beat() local(q) (
  q = max(slider2, 0.5);
  ceil((beat_position - 0.005) / q) * q;
);

// Address of event `idx` in `slot`
function evt_addr(slot, idx) (
  MEM_EVENTS + slot * (MAX_EVENTS * EVENT_SIZE) + idx * EVENT_SIZE;
);

function gmem_instance_base() (
  INSTANCE_BASE;
);

function clear_instance_block(base) local(i) (
  base > 0 ? (
    i = 0;
    loop(GMEM_INST_STRIDE,
      gmem[base + i] = 0;
      i += 1;
    );
  );
);

function apply_track_number(track_num) local(assigned i prev_base new_base) (
  assigned = floor(max(track_num, 1));
  assigned = min(assigned, 16);
  GMEM_MAX_INSTANCES > 0 ? assigned = min(assigned, GMEM_MAX_INSTANCES);

  prev_base = INSTANCE_BASE;

  slider1 = assigned;
  INSTANCE_ID   = assigned;
  new_base = INSTANCE_ID * GMEM_INST_STRIDE;
  INSTANCE_BASE = new_base;
  LAST_TRACK_NUMBER = assigned;

  prev_base != new_base ? clear_instance_block(prev_base);

  i = 0;
  loop(NUM_SLOTS,
    gmem[INSTANCE_BASE + GMEM_OFF_CMD + i] = 0;
    i += 1;
  );
  gmem[INSTANCE_BASE + GMEM_OFF_INSTANCE_CMD] = 0;
  gmem[INSTANCE_BASE + GMEM_OFF_INSTANCE_EXISTS] = 1;
);

// Send note-off for every note currently sounding in a playback slot
function send_all_notes_off(slot) local(n base) (
  base = MEM_PLAY_NOTES + slot * 128;
  n = 0;
  loop(128,
    base[n] ? (
      midisend(0, 0x80, n, 0);
      base[n] = 0;
    );
    n += 1;
  );
);

// Close out a recording: insert note-offs for any still-held notes, compute
// loop length, store final event count.
function finalize_recording(slot) local(n base ec addr ll) (
  ll = MEM_TARGET[slot] - MEM_REC_START[slot];
  ll <= 0 ? ll = 1;            // safety: at least 1 beat

  ec   = MEM_EVT_COUNT[slot];
  base = MEM_REC_NOTES + slot * 128;

  n = 0;
  loop(128,
    base[n] && ec < MAX_EVENTS ? (
      addr    = evt_addr(slot, ec);
      addr[0] = ll - 0.001;    // just before loop boundary
      addr[1] = 0x80;          // note-off
      addr[2] = n;
      addr[3] = 0;
      ec += 1;
      base[n] = 0;
    );
    n += 1;
  );

  MEM_EVT_COUNT[slot] = ec;
  MEM_LOOP_LEN[slot]  = ll;
);

// Close out an overdub pass: insert note-offs for held overdub notes at the
// quantised stop point in the loop timeline, keep existing loop length/content.
function finalize_overdub(slot) local(n base ec addr ll stop_off) (
  ll = MEM_LOOP_LEN[slot];
  ll <= 0 ? ll = 1;

  stop_off = MEM_TARGET[slot] - MEM_PLAY_START[slot];
  stop_off = stop_off - floor(stop_off / ll) * ll;

  ec   = MEM_EVT_COUNT[slot];
  base = MEM_REC_NOTES + slot * 128;

  n = 0;
  loop(128,
    base[n] && ec < MAX_EVENTS ? (
      addr    = evt_addr(slot, ec);
      addr[0] = stop_off;
      addr[1] = 0x80;
      addr[2] = n;
      addr[3] = 0;
      ec += 1;
      base[n] = 0;
    );
    n += 1;
  );

  MEM_EVT_COUNT[slot] = ec;
);

function compact_slot_state(slot) local(st has_content v) (
  st = MEM_STATE[slot];
  has_content = (MEM_EVT_COUNT[slot] > 0 || MEM_LOOP_LEN[slot] > 0);
  v = 0;

  st == STATE_EMPTY && !has_content ? (
    v = 0;
  ) :
  (st == STATE_REC_ARMED || st == STATE_RECORDING || st == STATE_STOP_REC_ARMED || st == STATE_OVERDUBBING) ? (
    v = 3;
  ) :
  (st == STATE_PLAYING || st == STATE_PLAY_ARMED || st == STATE_STOP_PLAY_ARMED || st == STATE_OD_ARMED || st == STATE_STOP_OD_ARMED) ? (
    v = 2;
  ) : (
    v = 1;
  );

  v;
);

function write_slot_state_gmem(slot) local(base) (
  base = gmem_instance_base();
  gmem[base + GMEM_OFF_STATE + slot]    = compact_slot_state(slot);
  gmem[base + GMEM_OFF_RAWSTATE + slot] = MEM_STATE[slot];
);

function write_all_slot_states_gmem() local(i) (
  i = 0;
  loop(NUM_SLOTS,
    write_slot_state_gmem(i);
    i += 1;
  );
  gmem[gmem_instance_base() + GMEM_OFF_INSTANCE_EXISTS] = 1;
);

function handle_slot_command(slot, cmd) local(prev_ss ss) (
  prev_ss = MEM_STATE[slot];
  ss = prev_ss;

  cmd == 1 ? ( // trigger
    ss == STATE_EMPTY ? (
      MEM_STATE[slot]  = STATE_REC_ARMED;
      MEM_TARGET[slot] = next_quant_beat();
    ) :
    ss == STATE_RECORDING ? (
      MEM_STATE[slot]  = STATE_STOP_REC_ARMED;
      MEM_TARGET[slot] = next_quant_beat();
    ) :
    ss == STATE_STOPPED ? (
      MEM_STATE[slot]  = STATE_PLAY_ARMED;
      MEM_TARGET[slot] = next_quant_beat();
    ) :
    ss == STATE_PLAYING ? (
      MEM_STATE[slot]  = STATE_STOP_PLAY_ARMED;
      MEM_TARGET[slot] = next_quant_beat();
    );
  );

  cmd == 2 ? ( // overdub
    ss == STATE_PLAYING && MEM_LOOP_LEN[slot] > 0 ? (
      MEM_STATE[slot]  = STATE_OD_ARMED;
      MEM_TARGET[slot] = next_quant_beat();
    ) :
    ss == STATE_OVERDUBBING ? (
      MEM_STATE[slot]  = STATE_STOP_OD_ARMED;
      MEM_TARGET[slot] = next_quant_beat();
    );
  );

  cmd == 3 ? ( // clear
    send_all_notes_off(slot);
    MEM_STATE[slot]     = STATE_EMPTY;
    MEM_EVT_COUNT[slot] = 0;
    MEM_LOOP_LEN[slot]  = 0;
    memset(MEM_REC_NOTES + slot * 128, 0, 128);
  );

  MEM_STATE[slot] != prev_ss ? write_slot_state_gmem(slot);
);

@slider
new_track_num = floor(max(slider1, 1));
new_track_num = min(new_track_num, 16);
GMEM_MAX_INSTANCES > 0 ? new_track_num = min(new_track_num, GMEM_MAX_INSTANCES);

new_track_num != LAST_TRACK_NUMBER ? (
  apply_track_number(new_track_num);
  write_all_slot_states_gmem();
);

FEEDBACK_REFRESH_PENDING = 1;

// ════════════════════════════════════════════════════════════════════════════════
@block

// ─── Timing ────────────────────────────────────────────────────────────────────
bps       = tempo / (60 * srate);        // beats per sample
blk_beats = samplesblock * bps;          // beats in this block
blk_end   = beat_position + blk_beats;

// ─── gmem heartbeat sync + reindex ────────────────────────────────────────────
global_hb = floor(gmem[GMEM_GLOBAL_HEARTBEAT] + 0.5);
(INSTANCE_ID <= 0 || global_hb != LAST_GMEM_HEARTBEAT) ? (
  LAST_GMEM_HEARTBEAT = global_hb;
  apply_track_number(slider1);
  FEEDBACK_REFRESH_PENDING = 1;
);

gmbase = gmem_instance_base();

// ─── One-shot feedback refresh (all slots) ────────────────────────────────────
FEEDBACK_REFRESH_PENDING ? (
  write_all_slot_states_gmem();
  FEEDBACK_REFRESH_PENDING = 0;
);

// ─── instance command polling (non-zero=full-update, then ACK=0) ─────────────
inst_cmd_addr = gmbase + GMEM_OFF_INSTANCE_CMD;
inst_cmd = floor(gmem[inst_cmd_addr] + 0.5);
gmem[inst_cmd_addr] != 0 ? (
  write_all_slot_states_gmem();
  gmem[inst_cmd_addr] = 0;
);

// ─── gmem command polling (non-zero=pending, then ACK=0) ─────────────────────
i = 0;
loop(NUM_SLOTS,
  cmd_addr = gmbase + GMEM_OFF_CMD + i;
  cmd_raw = gmem[cmd_addr];
  cmd_raw != 0 ? (
    cmd = floor(abs(cmd_raw) + 0.5);
    cmd < 1 ? cmd = 1;
    cmd > 3 ? cmd = 3;
    handle_slot_command(i, cmd);
    gmem[cmd_addr] = 0;
  );
  i += 1;
);

// ─── 1. Armed-state transitions ────────────────────────────────────────────────
i = 0;
loop(NUM_SLOTS,
  st  = MEM_STATE[i];
  prev_st = st;
  tgt = MEM_TARGET[i];

  // REC_ARMED → RECORDING
  st == STATE_REC_ARMED && blk_end >= tgt ? (
    MEM_STATE[i]     = STATE_RECORDING;
    MEM_REC_START[i] = tgt;
    MEM_EVT_COUNT[i] = 0;
    memset(MEM_REC_NOTES + i * 128, 0, 128);
  );

  // STOP_REC_ARMED → finalise + PLAYING
  st == STATE_STOP_REC_ARMED && blk_end >= tgt ? (
    finalize_recording(i);
    MEM_STATE[i]      = STATE_PLAYING;
    MEM_PLAY_START[i] = tgt;
  );

  // PLAY_ARMED → PLAYING
  st == STATE_PLAY_ARMED && blk_end >= tgt ? (
    MEM_STATE[i]      = STATE_PLAYING;
    MEM_PLAY_START[i] = tgt;
  );

  // OD_ARMED → OVERDUBBING
  st == STATE_OD_ARMED && blk_end >= tgt ? (
    MEM_LOOP_LEN[i] > 0 ? (
      MEM_STATE[i] = STATE_OVERDUBBING;
      memset(MEM_REC_NOTES + i * 128, 0, 128);
    ) : (
      MEM_STATE[i] = STATE_STOPPED;
    );
  );

  // STOP_OD_ARMED → finalise overdub + PLAYING
  st == STATE_STOP_OD_ARMED && blk_end >= tgt ? (
    finalize_overdub(i);
    MEM_STATE[i] = STATE_PLAYING;
  );

  // STOP_PLAY_ARMED → STOPPED
  st == STATE_STOP_PLAY_ARMED && blk_end >= tgt ? (
    send_all_notes_off(i);
    MEM_STATE[i] = STATE_STOPPED;
  );

  MEM_STATE[i] != prev_st ? write_slot_state_gmem(i);

  i += 1;
);

// ─── 2. Process incoming MIDI ──────────────────────────────────────────────────
while (midirecv(moffs, m1, m2, m3)) (
  mst   = m1 & 0xF0;
  midisend(moffs, m1, m2, m3);

  // Store into every slot that is currently recording
  is_note_evt = (mst == 0x80 || mst == 0x90);
  rec_q = max(slider6, 0);
  j = 0;
  loop(NUM_SLOTS,
    (MEM_STATE[j] == STATE_RECORDING || MEM_STATE[j] == STATE_OVERDUBBING) ? (
      ec = MEM_EVT_COUNT[j];
      ec < MAX_EVENTS ? (
        sbeat = beat_position + moffs * bps;        // sample-accurate beat
        MEM_STATE[j] == STATE_RECORDING ? (
          boff = sbeat - MEM_REC_START[j];
        ) : (
          llj = MEM_LOOP_LEN[j];
          llj > 0 ? (
            boff = sbeat - MEM_PLAY_START[j];
            boff = boff - floor(boff / llj) * llj;
          ) : (
            boff = -1;
          );
        );

        // Quantize recorded NOTE event times if enabled (in beats).
        // 1/16th = 0.25 beats, 1/32nd = 0.125 beats, etc.
        rec_q > 0 && is_note_evt && boff >= 0 ? (
          boff = floor(boff / rec_q + 0.5) * rec_q;

          MEM_STATE[j] == STATE_OVERDUBBING ? (
            llj > 0 ? boff = boff - floor(boff / llj) * llj;
          ) : (
            boff < 0 ? boff = 0;
          );
        );

        boff >= 0 ? (
          addr    = evt_addr(j, ec);
          addr[0] = boff;
          addr[1] = m1;
          addr[2] = m2;
          addr[3] = m3;
          MEM_EVT_COUNT[j] = ec + 1;

          // Track held notes for finalize_recording
          mst == 0x90 && m3 > 0 ? (
            (MEM_REC_NOTES + j * 128)[m2] = 1;
          );
          (mst == 0x80 || (mst == 0x90 && m3 == 0)) ? (
            (MEM_REC_NOTES + j * 128)[m2] = 0;
          );
        );
      );
    );
    j += 1;
  );
);

// ─── 3. Playback ───────────────────────────────────────────────────────────────
i = 0;
loop(NUM_SLOTS,
  MEM_STATE[i] == STATE_PLAYING ? (
    ll = MEM_LOOP_LEN[i];
    ll > 0 ? (
      elapsed = beat_position - MEM_PLAY_START[i];

      // Current position inside the loop  (fmod that works for negative values)
      lp     = elapsed - floor(elapsed / ll) * ll;
      lp_end = lp + blk_beats;

      ec = MEM_EVT_COUNT[i];
      j  = 0;
      loop(ec,
        addr = evt_addr(i, j);
        eb   = addr[0];               // event beat offset within loop

        // Does this event fall inside the current block window?
        fire = 0;
        lp_end > ll ? (
          // Block straddles the loop boundary
          (eb >= lp && eb < ll)          ? fire = 1;
          (eb >= 0  && eb < lp_end - ll) ? fire = 1;
        ) : (
          (eb >= lp && eb < lp_end)      ? fire = 1;
        );

        fire ? (
          // Sample offset within the block
          d  = eb - lp;
          d < 0 ? d += ll;
          so = floor(d / bps);
          so = min(max(so, 0), samplesblock - 1);

          midisend(so, addr[1], addr[2], addr[3]);

          // Track sounding notes so we can silence them on stop
          es = addr[1] & 0xF0;
          es == 0x90 && addr[3] > 0 ? (
            (MEM_PLAY_NOTES + i * 128)[addr[2]] = 1;
          );
          (es == 0x80 || (es == 0x90 && addr[3] == 0)) ? (
            (MEM_PLAY_NOTES + i * 128)[addr[2]] = 0;
          );
        );

        j += 1;
      );
    );
  );
  i += 1;
);

// ════════════════════════════════════════════════════════════════════════════════
@gfx 420 310

gfx_setfont(1, "Arial", 14);
gfx_setfont(2, "Arial", 11);
cols = 2;
rows = 4;
gap  = 2;
slot_w = (gfx_w - gap * (cols + 1)) / cols;
slot_h = (gfx_h - gap * (rows + 1)) / rows;
preview_on = slider7 >= 0.5;

i = 0;
loop(NUM_SLOTS,
  st = MEM_STATE[i];
  col = i % cols;
  row = floor(i / cols);
  sx = gap + col * (slot_w + gap);
  sy = gap + row * (slot_h + gap);

  // ── Slot background colour ──
  st == STATE_EMPTY ? (
    gfx_r = 0.15; gfx_g = 0.15; gfx_b = 0.15;
  ) :
  (st == STATE_REC_ARMED || st == STATE_STOP_REC_ARMED) ? (
    gfx_r = 0.55; gfx_g = 0.30; gfx_b = 0.05;
  ) :
  st == STATE_RECORDING ? (
    gfx_r = 0.80; gfx_g = 0.10; gfx_b = 0.10;
  ) :
  (st == STATE_OD_ARMED || st == STATE_STOP_OD_ARMED) ? (
    gfx_r = 0.10; gfx_g = 0.45; gfx_b = 0.65;
  ) :
  st == STATE_OVERDUBBING ? (
    gfx_r = 0.15; gfx_g = 0.75; gfx_b = 0.85;
  ) :
  (st == STATE_PLAYING || st == STATE_PLAY_ARMED || st == STATE_STOP_PLAY_ARMED) ? (
    gfx_r = 0.10; gfx_g = 0.55; gfx_b = 0.10;
  ) :
  st == STATE_STOPPED ? (
    gfx_r = 0.25; gfx_g = 0.25; gfx_b = 0.45;
  );

  gfx_a = 1;
  gfx_rect(sx, sy, slot_w, slot_h);

  // Always show cell number in top-left
  gfx_setfont(2, "Arial", 11);
  gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.9;
  sprintf(#cell_txt, "%d", i + 1);
  gfx_x = sx + 4;
  gfx_y = sy + 3;
  gfx_drawstr(#cell_txt);

  // Note preview (full-slot piano-roll): x=time in loop, y=pitch
  preview_on && MEM_EVT_COUNT[i] > 0 ? (
    pv_x = sx + 1;
    pv_y = sy + 1;
    pv_w = slot_w - 2;
    pv_h = slot_h - 2;

    ecv = MEM_EVT_COUNT[i];
    llv = MEM_LOOP_LEN[i];
    llv > 0 ? (
      j = 0;
      loop(ecv,
        addr = evt_addr(i, j);
        es   = addr[1] & 0xF0;
        en   = addr[2];
        ev   = addr[3];

        (es == 0x90 && ev > 0) ? (
          px = pv_x + (addr[0] / llv) * (pv_w - 2);
          py = pv_y + (1 - en / 127) * (pv_h - 2);

          px = min(max(px, pv_x), pv_x + pv_w - 2);
          py = min(max(py, pv_y), pv_y + pv_h - 2);

          gfx_r = 0.90; gfx_g = 0.95; gfx_b = 0.30; gfx_a = 0.95;
          gfx_rect(px, py, 2, 2);
        );

        j += 1;
      );
    );
  );

  // Playback progress bar with alpha blending to avoid flickering
  (st == STATE_PLAYING || st == STATE_OVERDUBBING) && MEM_LOOP_LEN[i] > 0 ? (
    elapsed_pb = beat_position - MEM_PLAY_START[i];
    lp_pb = elapsed_pb - floor(elapsed_pb / MEM_LOOP_LEN[i]) * MEM_LOOP_LEN[i];
    pct = lp_pb / MEM_LOOP_LEN[i];
    
    // Use base color + highlight for progress bar
    st == STATE_PLAYING || st == STATE_PLAY_ARMED || st == STATE_STOP_PLAY_ARMED ? (
      gfx_r = 0.25; gfx_g = 0.80; gfx_b = 0.25;
    ) : (
      gfx_r = 0.30; gfx_g = 0.95; gfx_b = 0.95;
    );
    gfx_a = 0.6;
    pb_x = sx;
    pb_y = sy;
    pb_w = slot_w;
    gfx_rect(pb_x, pb_y, pb_w * pct, slot_h);
  );

  // Centered beat count during active recording / playback only
  show_beats = 0;
  beat_val = 0;
  st == STATE_RECORDING ? (
    beat_val = beat_position - MEM_REC_START[i];
    beat_val < 0 ? beat_val = 0;
    show_beats = 1;
  );
  (st == STATE_PLAYING || st == STATE_OVERDUBBING) && MEM_LOOP_LEN[i] > 0 ? (
    beat_val = MEM_LOOP_LEN[i];
    show_beats = 1;
  );

  show_beats ? (
    gfx_setfont(1, "Arial", 14);
    gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.95;
    sprintf(#beat_txt, "%.1f", beat_val);
    gfx_measurestr(#beat_txt, tw, th);
    gfx_x = sx + (slot_w - tw) * 0.5;
    gfx_y = sy + (slot_h - th) * 0.5;
    gfx_drawstr(#beat_txt);
  );

  i += 1;
);

/*
// ─── Status row at bottom ──────────────────────────────────────────────────────
gfx_r = 0.20; gfx_g = 0.20; gfx_b = 0.20; gfx_a = 1;
status_y = gap + rows * (slot_h + gap);
gfx_rect(0, status_y, gfx_w, gfx_h - status_y);

gfx_setfont(2, "Arial", 12);
gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 0.9;

gmbase_val = gmem_instance_base();
sprintf(#status_txt, "Instance: %d | gmem base: %d | State: %d %d %d %d %d %d %d %d | Cmd: %d %d %d %d %d %d %d %d |  Inst Cmd: %d",
  INSTANCE_ID,
  gmbase_val,
  gmem[gmbase_val + 0], gmem[gmbase_val + 1], gmem[gmbase_val + 2], gmem[gmbase_val + 3],
  gmem[gmbase_val + 4], gmem[gmbase_val + 5], gmem[gmbase_val + 6], gmem[gmbase_val + 7],
  gmem[gmbase_val + 8], gmem[gmbase_val + 9], gmem[gmbase_val + 10], gmem[gmbase_val + 11],
  gmem[gmbase_val + 12], gmem[gmbase_val + 13], gmem[gmbase_val + 14], gmem[gmbase_val + 15],
  gmem[gmbase_val + 16]
);

gfx_x = gap + 4;
gfx_y = status_y + 4;
gfx_drawstr(#status_txt);
*/

// ════════════════════════════════════════════════════════════════════════════════
@serialize

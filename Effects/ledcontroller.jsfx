desc: LED Strip Controller
// Converts MIDI messages into ARGB segment values written to the shared gmem block
// "ledcontroller", which GmemToOscDispatcher reads and broadcasts as OSC messages.
//
// Named-list sliders in JSFX use 0-based indices regardless of min/max.
// MIDI protocol (all channels are 0-based):
//   Notes  0-11  on own channel  -> segment brightness (velocity * 2, 0-254)
//   Note off 0-11                -> segment brightness = 0
//   Note 12 on                   -> Blue  channel (velocity * 2)
//   Note 13 on                   -> Green channel (velocity * 2)
//   Note 14 on                   -> Red   channel (velocity * 2)
//   CC 110                       -> brightness multiplier (value / 127)
//
// MIDI data is always forwarded unchanged to allow chaining multiple instances.

slider1:0<0,3,1{Strip 1,Strip 2,Strip 3,Strip 4}>LED Strip
options:gmem=ledcontroller

@init
// Segment brightness values stored at local mem[0..11], range 0-254.
i = 0; loop(12, mem[i] = 0; i += 1;);

strip_r   = 255;
strip_g   = 255;
strip_b   = 255;
strip_mul = 1.0;

@slider
strip_idx = slider1;                 // 0-based strip index (0..3)
gmem_base = strip_idx * 12;          // each strip occupies 12 consecutive gmem cells

@block
while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & 0xF0;

  // Always forward MIDI so downstream plugins receive it unchanged.
  midisend(offset, msg1, msg2, msg3);

  // Note On with non-zero velocity
  status == 0x90 && msg3 > 0 ? (
    msg2 <= 11 ? mem[msg2] = msg3 * 2;  // segments 0-11: raw brightness 0-254
    msg2 == 12 ? strip_b = msg3 * 2;    // note 12 -> Blue
    msg2 == 13 ? strip_g = msg3 * 2;    // note 13 -> Green
    msg2 == 14 ? strip_r = msg3 * 2;    // note 14 -> Red
  );

  // Note Off (status 0x80) or Note On with velocity 0
  (status == 0x80 || (status == 0x90 && msg3 == 0)) ? (
    msg2 <= 11 ? mem[msg2] = 0;
  );

  // CC 110 -> per-strip brightness multiplier (0.0-1.0)
  status == 0xB0 && msg2 == 110 ? (
    strip_mul = msg3 / 127;
  );
);

// Write packed ARGB int32 into gmem for each of the 12 segments.
// A = segment brightness scaled by the strip multiplier.
// R, G, B = strip base color (shared across all segments for now).
// Bitwise << produces signed int32 results, which is what the OSC int32 type requires.
i = 0;
loop(12,
  a = floor(mem[i] * strip_mul);
  a = max(0, min(255, a));
  gmem[gmem_base + i] = (a << 24) | (strip_r << 16) | (strip_g << 8) | strip_b;
  i += 1;
);

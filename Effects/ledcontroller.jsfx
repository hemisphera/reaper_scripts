desc: LED Strip Controller
// Converts MIDI messages into ARGB segment values written to the shared gmem block
// "ledcontroller", which GmemToOscDispatcher reads and broadcasts as OSC messages.
//
// Named-list sliders in JSFX use 0-based indices regardless of min/max.
// MIDI protocol (all channels are 0-based):
//   Notes  0-11  on own channel  -> segment brightness (velocity * 2, 0-254)
//   Note off 0-11                -> segment brightness = 0
//   Note 12 on                   -> Blue  channel (velocity * 2)
//   Note 13 on                   -> Green channel (velocity * 2)
//   Note 14 on                   -> Red   channel (velocity * 2)
//   Note 15 on                   -> Program (velocity = program number; 0 = passthrough)
//   Note 15 off / velocity 0     -> Program = 0 (passthrough), position reset
//   Note 16 on                   -> Generic argument (velocity written as-is to slot 14)
//   CC 110                       -> brightness multiplier (value / 127)
//
// gmem layout per strip (16 cells, base = strip_idx * 16):
//   [0..11]  packed ARGB int32 for each segment (raw brightness, no multiplier applied)
//   [12]     current program number (0 = no program, emit segments as-is)
//   [13]     program position in 32nd notes (resets on program change)
//   [14]     generic argument (written as-is from Note 16 velocity)
//   [15]     brightness multiplier (0.0-1.0); backend applies this when rendering
//
// MIDI data is always forwarded unchanged to allow chaining multiple instances.

slider1:0<0,3,1{Strip 1,Strip 2,Strip 3,Strip 4}>LED Strip
options:gmem=ledcontroller

@init
// Segment brightness values stored at local mem[0..11], range 0-254.
i = 0; loop(12, mem[i] = 0; i += 1;);

strip_r          = 255;
strip_g          = 255;
strip_b          = 255;
strip_mul        = 1.0;
current_program  = 0;
program_start_beat = 0.0;

@slider
strip_idx = slider1;                 // 0-based strip index (0..3)
gmem_base = strip_idx * 16;          // each strip occupies 16 consecutive gmem cells

@block
while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & 0xF0;

  // Always forward MIDI so downstream plugins receive it unchanged.
  midisend(offset, msg1, msg2, msg3);

  // Note On with non-zero velocity
  status == 0x90 && msg3 > 0 ? (
    msg2 <= 11 ? mem[msg2] = msg3 * 2;  // segments 0-11: raw brightness 0-254
    msg2 == 12 ? strip_b = msg3 * 2;    // note 12 -> Blue
    msg2 == 13 ? strip_g = msg3 * 2;    // note 13 -> Green
    msg2 == 14 ? strip_r = msg3 * 2;    // note 14 -> Red
    msg2 == 15 ? (                       // note 15 -> Program (velocity = program number)
      msg3 != current_program ? (
        current_program = msg3;
        program_start_beat = beat_position;
      );
    );
    msg2 == 16 ? (                       // note 16 -> Generic argument written as-is to slot 14
      gmem[gmem_base + 14] = msg3;
    );
  );

  // Note Off (status 0x80) or Note On with velocity 0
  (status == 0x80 || (status == 0x90 && msg3 == 0)) ? (
    msg2 <= 11 ? mem[msg2] = 0;
    msg2 == 15 ? (                       // note 15 off -> stop program
      current_program != 0 ? (
        current_program = 0;
        program_start_beat = beat_position;
      );
    );
  );

  // CC 110 -> per-strip brightness multiplier (0.0-1.0)
  status == 0xB0 && msg2 == 110 ? (
    strip_mul = msg3 / 127;
  );
);

// Advance program position in 32nd notes while transport is playing.
// beat_position is in quarter notes; *8 converts to 32nds.
// Position is relative to the beat at which the current program was set.
(play_state & 1) ? (
  program_pos = max(0, (beat_position - program_start_beat) * 8);
);

// Write packed ARGB int32 into gmem for each of the 12 segments.
// A = raw segment brightness (0-254) as received from MIDI; multiplier not applied here.
// R, G, B = strip base color (shared across all segments for now).
// Bitwise << produces signed int32 results, which is what the OSC int32 type requires.
i = 0;
loop(12,
  a = max(0, min(255, floor(mem[i])));
  gmem[gmem_base + i] = (a << 24) | (strip_r << 16) | (strip_g << 8) | strip_b;
  i += 1;
);

// Write program number, position, and multiplier into the extra gmem slots.
gmem[gmem_base + 12] = current_program;
gmem[gmem_base + 13] = floor(program_pos);
gmem[gmem_base + 15] = strip_mul;
